{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eventiapp-public",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "f9f5a5aec42f408280b37cf88f889edc"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true
    }
  }
}
